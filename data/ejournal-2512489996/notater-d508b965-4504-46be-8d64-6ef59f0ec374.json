{"Header":{"DatoFra":"2024-11-26T08:00:00Z","DatoTil":"2025-03-20T10:25:00Z"},"Notater":[{"NotatType":"Notat","DatoFra":"2025-02-11T05:00:00Z","EnhedsInformation":{"Kode":"100103","AfdelingsKode":"238981000016005","SygehusKode":"8071000016009","Institution":"Odense Universitetshospital - Svendborg","Afdeling":"OUH Hjertemedicinsk Ambulatorium B (Odense)"},"Overskrift":"Journalnotat - somatik","Broedtekst":"<html><head></head><body><p><br><b>Aktuelt:</b></p><p>Beskrivelse: Patienten indlægges d.d. til videre udredning. Patienten skal til røntgen af thorax i morgen tidlig kl. 8, siddende transport er bestilt. Patient efterfølgende udskrives til kontrol hos egen læge.</p><p><br><b>Objektiv undersøgelse standard:</b></p><p>Almen tilstand: Almentilstand er over middel.</p><p>Psykisk: Patienten er lettere depressiv. Patienten får mindste dosis antidepressiv medicin.</p><p>Abdomen: Er blød og uøm.</p></body></html>","Fritekst":"","BehandlerNavn":"929c3608-2cac-553e-8a56-caae26d771c1","BehandlerTitel":"Læge","RegistreretAf":"929c3608-2cac-553e-8a56-caae26d771c1","Noegle":"929b6fc8-7935-4eb5-8705-87adb8697e3d"},{"NotatType":"Notat","DatoFra":"2025-03-13T10:00:00Z","EnhedsInformation":{"Kode":"100102","AfdelingsKode":"581831000016007","SygehusKode":"8071000016009","Institution":"Odense Universitetshospital - Svendborg","Afdeling":"OUH Hjertemed. Amb. K (Odense)"},"Overskrift":"Journalnotat - somatik","Broedtekst":"<html><head></head><body><p><br><b>Aktuelt:</b></p><p>Beskrivelse: Test Test</p></body></html>","Fritekst":"","BehandlerNavn":"Teknisk EPJKonsulent","BehandlerTitel":"EPJ konsulent","RegistreretAf":"Teknisk EPJKonsulent","Noegle":"268f3d8f-d3e5-426c-98f8-6b9c185d5e69"},{"NotatType":"Notat","DatoFra":"2025-01-29T07:39:00Z","EnhedsInformation":{"Kode":"100104","AfdelingsKode":"239101000016008","SygehusKode":"8071000016009","Institution":"Odense Universitetshospital - Svendborg","Afdeling":"OUH Hæmatologisk Afs. X (Odense)"},"Overskrift":"Implantat indsat","Broedtekst"